{
  "name": "avn-playlens",
  "version": "0.1.0",
  "private": true,
  "description": "Local web console for testing Unity Android builds: devices, QR pairing, live logs, AVN plugin and Firebase checks.",
  "type": "module",
  "workspaces": [
    "packages/server",
    "packages/web",
    "packages/ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run build && node packages/server/bin/avn-playlens.mjs",
    "replay": "npm run build && node packages/server/bin/avn-playlens.mjs --replay",
    "build": "npm run build -w packages/web",
    "dev:server": "node packages/server/bin/avn-playlens.mjs --dev --replay",
    "dev:web": "npm run dev -w packages/web",
    "test": "npm run test:server && npm run test:web",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc -p packages/web/tsconfig.json --noEmit && npm run typecheck -w @avn/ui",
    "test:server": "node --test \"packages/server/**/*.test.mjs\"",
    "test:web": "vitest run --config packages/web/vitest.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
